# Kezvra AI — environment template. Copy to .env and fill in. Never commit .env.

# ── Core ──────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://kezvra.example.com
# openssl rand -base64 48
AUTH_SECRET=
# Comma-separated emails that become SUPER_ADMIN on signup
SUPER_ADMIN_EMAILS=
LOG_LEVEL=info

# ── Database & Redis (docker-compose builds the URLs from these) ──
POSTGRES_USER=kezvra
POSTGRES_PASSWORD=
POSTGRES_DB=kezvra
REDIS_PASSWORD=
# For running outside docker compose:
DATABASE_URL=postgresql://kezvra:CHANGE_ME@localhost:5432/kezvra
REDIS_URL=redis://localhost:6379

# ── OpenRouter (required for AI) ───────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Hard ceiling of upstream spend per UTC day, USD
OPENROUTER_DAILY_BUDGET_USD=50
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Auth providers ────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (verification, password reset) ──────────────
# smtp://user:pass@smtp.example.com:587
SMTP_URL=
EMAIL_FROM=Kezvra AI <no-reply@kezvra.example.com>

# ── S3-compatible storage (files, images) ──────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

# ── Payments ──────────────────────────────────────────
STRIPE_SECRET_KEY=
# from `stripe listen` or the Dashboard webhook endpoint for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Telegram Stars (future Mini App). Webhook: setWebhook url=/api/webhooks/telegram secret_token=…
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Seed (optional, creates a SUPER_ADMIN with a password) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
